(stmts#Copyright (c) 2026 Ragnarök contributors
SPDX-License-Identifier: MIT OR Apache-2.0
Services proof lease, one serialized host and one native proof worker.
phase 0 Idle, 1 Queued, 2 Running, 3 Done; other abstracts one preparation/disk lease.
Mut 1 removes a canonical getter gate, 2 lets unrelated stop resume RPC,
3 resumes RPC on logical cancellation. One active proof slot; no ticket or payload model.
Source: src/app/services.nim beginStateProof, stopPreparation, collectStateProof,
stopStateProofs, chainView and tick. Detailed source boundary in feature contract.#
  (variables :phase.0. :other.0. :paused.0. :cancelled.0. :stopping.0. :err.0.)
  (assign Mut.0. 0)
  (assign Witness.0. (false))
  (def :Init.0.
    (and (prime phase.0. 0) (prime other.0. (false)) (prime paused.0. (false))
         (prime cancelled.0. (false)) (prime stopping.0. (false)) (prime err.0. 0)))
  (def :BeginProof.0.
    (and (not stopping.0.) (eq phase.0. 0) (not other.0.) (not paused.0.)
         (prime phase.0. 1) (prime paused.0. (true)) (prime cancelled.0. (false))))
  (def :Run.0.
    (and (not stopping.0.) (eq phase.0. 1) (prime phase.0. 2)))
  (def :Done.0.
    (and (eq phase.0. 2) (prime phase.0. 3)))
  (def :Cancel.0.
    (and (not stopping.0.) (neq phase.0. 0) (prime cancelled.0. (true))
         (prime paused.0. (if (eq Mut.0. 3) (false) paused.0.))))
  (def :Collect.0.
    (and (not stopping.0.) (eq phase.0. 3)
         (prime phase.0. 0) (prime paused.0. (false))))
  (def :Close.0.
    (and (not stopping.0.) (not other.0.) (prime stopping.0. (true))))
  (def :Join.0.
    (and stopping.0. (or (eq phase.0. 1) (eq phase.0. 3))
         (prime phase.0. 0) (prime paused.0. (false))))
  (def :BeginOther.0.
    (and (eq phase.0. 0) (not other.0.) (not paused.0.)
         (prime other.0. (true)) (prime paused.0. (true))))
  (def :StopOther.0.
    (and (prime other.0. (false))
         (prime paused.0. (if (or other.0. (eq Mut.0. 2)) (false) paused.0.))))
  (def :ReadCanonical.0.
    (and (not other.0.) (or (eq phase.0. 0) (eq Mut.0. 1))
         (prime err.0. (if (eq phase.0. 0) err.0. 1))))
  (def :Next.0.
    (or BeginProof.0. Run.0. Done.0. Cancel.0. Collect.0. Close.0. Join.0.
        BeginOther.0. StopOther.0. ReadCanonical.0.))
  (def :Safe.0.
    (and (eq err.0. 0) (or (eq phase.0. 0) paused.0.)
         (or (not other.0.) (and (eq phase.0. 0) paused.0.))))
  (def :Reached.0.
    (and (eq phase.0. 3) cancelled.0. paused.0.))
  (spec (always-stutter Init.0. Next.0.
    (tuple phase.0. other.0. paused.0. cancelled.0. stopping.0. err.0.)))
  (check (if Witness.0. (not Reached.0.) Safe.0.)))
