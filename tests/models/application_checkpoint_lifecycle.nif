(stmts#Copyright (c) 2026 Ragnarök contributors
SPDX-License-Identifier: MIT OR Apache-2.0
One staged Publish/Verify request, serialized host and one checkpoint worker.
phase 0 Idle, 1 Staged, 2 Running, 3 Executing, 4 Done; pc 0 wait, 1 IO, 2 retired, 3 exited.
req/returned 1 Publish, 2 Verify; io 0 absent, 1 success, 2 failure; receipt 0 absent, 1 Cancelled, 2 Completed.
Hypothesis: cancellation after dispatch hides entered IO, or joined close loses/mislabels a receipt.
Source: src/app/checkpoint_worker.nim stage/stageVerification/begin/cancel/run/collect/close.
The state checkpoint worker shares the staging/cancel/join transitions; retry is modeled separately.#
  (variables :phase.0. :pc.0. :stop.0. :used.0. :cancelled.0.
              :io.0. :receipt.0. :req.0. :returned.0.)
  (assign Mut.0. 0)
  (assign Witness.0. (false))
  (def :Init.0.
    (and (prime phase.0. 0) (prime pc.0. 0) (prime stop.0. (false))
         (prime used.0. (false)) (prime cancelled.0. (false)) (prime io.0. 0)
         (prime receipt.0. 0) (prime req.0. 0) (prime returned.0. 0)))
  (def :Stage.0.#stage/stageVerification: own one bounded request before dispatch, with no IO.#
    (and (not used.0.) (not stop.0.) (eq phase.0. 0) (prime used.0. (true))
         (prime phase.0. 1) (or (prime req.0. 1) (prime req.0. 2))))
  (def :Begin.0.#begin: matching staged admission changes Running under the lock and signals.#
    (and (not stop.0.) (eq phase.0. 1) (prime phase.0. 2)))
  (def :Cancel.0.#cancel: only Staged may become Cancelled; Done still retains capacity.#
    (and (not stop.0.)
         (or (eq phase.0. 1) (and (eq Mut.0. 1) (ge phase.0. 2)))
         (prime cancelled.0. (true)) (prime phase.0. 4)))
  (def :Dispatch.0.#run: stop and Running are inspected under one mutex before native entry.#
    (and (not stop.0.) (eq pc.0. 0) (eq phase.0. 2)
         (prime phase.0. 3) (prime pc.0. 1)))
  (def :Execute.0.#execute: native return and all local aliases precede Done publication.#
    (and (eq pc.0. 1) (prime pc.0. 2) (or (prime io.0. 1) (prime io.0. 2))))
  (def :Publish.0.#run: reacquire the lock only after the activation has retired.#
    (and (eq pc.0. 2) (prime pc.0. 0) (prime phase.0. 4)))
  (def :Collect.0.#collect: Done preserves cancellation or the actual operation/result pair.#
    (and (not stop.0.) (eq phase.0. 4) (prime phase.0. 0)
         (prime receipt.0. (if cancelled.0. 1 2))
         (prime returned.0. (if cancelled.0. 0 (if (eq Mut.0. 3) 1 req.0.)))))
  (def :Close.0.#close: stop and wake, then wait for an exited worker without dropping its buffer.#
    (and (not stop.0.) (prime stop.0. (true))))
  (def :Exit.0.#run: a dispatched activation finishes before stop is observed at the wait boundary.#
    (and stop.0. (eq pc.0. 0) (prime pc.0. 3)))
  (def :Join.0.#close: retain actual completed work; only unstarted Staged/Running may be Cancelled.#
    (and stop.0. (eq pc.0. 3)
         (prime receipt.0.
           (if (eq phase.0. 4) (if cancelled.0. 1 (if (eq Mut.0. 2) 0 2))
             (if (or (eq phase.0. 1) (eq phase.0. 2)) 1 receipt.0.)))
         (prime returned.0.
           (if (and (eq phase.0. 4) (not cancelled.0.))
             (if (eq Mut.0. 3) 1 req.0.) returned.0.))
         (prime phase.0. 0)))
  (def :Next.0.
    (or Stage.0. Begin.0. Cancel.0. Dispatch.0. Execute.0. Publish.0.
        Collect.0. Close.0. Exit.0. Join.0.))
  (def :Safe.0.
    (and (or (and (neq pc.0. 1) (neq pc.0. 2)) (eq phase.0. 3))
         (or (not cancelled.0.) (eq io.0. 0))
         (or (eq io.0. 0) (eq phase.0. 3) (eq phase.0. 4) (eq receipt.0. 2))
         (or (neq receipt.0. 2) (and (gt io.0. 0) (eq returned.0. req.0.)))
         (or (neq receipt.0. 1) (eq io.0. 0))))
  (def :Reached.0.
    (and stop.0. (eq pc.0. 3) (eq req.0. 2) (eq returned.0. 2)
         (eq receipt.0. 2) (eq io.0. 2)))
  (spec (always-stutter Init.0. Next.0.
    (tuple phase.0. pc.0. stop.0. used.0. cancelled.0. io.0. receipt.0. req.0. returned.0.)))
  (check (if Witness.0. (not Reached.0.) Safe.0.)))
