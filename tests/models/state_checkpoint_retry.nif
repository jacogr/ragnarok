(stmts#Copyright (c) 2026 Ragnarök contributors
SPDX-License-Identifier: MIT OR Apache-2.0
One Advance request and at most one explicit retry; serialized host, one native worker.
phase 0 Staged, 1 dispatched, 2 Done, 3 collected; outcome 0 absent, 1 success, 2 StaleHead, 3 uncertain.
Generation 1 is retained by the old caller; 2 is the fresh retry authority. No wrap is modeled.
Hypothesis: uncertain/successful IO retries implicitly, or an old ticket retires a retried request.
Source: src/state/checkpoint/worker.nim begin/peek/retry/matches/collect.
Native execution returns one abstract actual outcome; successful retry still requires explicit begin.#
  (variables :phase.0. :outcome.0. :generation.0. :retried.0. :err.0.)
  (assign Mut.0. 0)
  (assign Witness.0. (false))
  (def :Init.0.
    (and (prime phase.0. 0) (prime outcome.0. 0) (prime generation.0. 1)
         (prime retried.0. (false)) (prime err.0. 0)))
  (def :Begin.0.#begin: no IO occurs in Staged until explicit dispatch with current authority.#
    (and (eq phase.0. 0) (prime phase.0. 1)))
  (def :Complete.0.#run: success, stale head and uncertainty are distinct actual receipts.#
    (and (eq phase.0. 1) (prime phase.0. 2)
         (or (prime outcome.0. 1) (prime outcome.0. 2) (prime outcome.0. 3))))
  (def :Peek.0.#peek: repeated observation leaves capacity, result and generation unchanged.#
    (and (eq phase.0. 2) (unchanged outcome.0.)))
  (def :Retry.0.#retry: only an exact Advance/StaleHead refusal can restage the retained buffer.#
    (and (eq phase.0. 2) (not retried.0.)
         (or (eq outcome.0. 2) (and (eq Mut.0. 1) (eq outcome.0. 3))
             (and (eq Mut.0. 2) (eq outcome.0. 1)))
         (prime err.0. (if (eq outcome.0. 2) 0 1))
         (prime generation.0. 2) (prime retried.0. (true))
         (prime phase.0. 0) (prime outcome.0. 0)))
  (def :OldTicket.0.#matches/collect: old generations cannot collect the retried slot, even when Done.#
    (and (eq generation.0. 2) (eq phase.0. 2)
         (prime err.0. (if (eq Mut.0. 3) 2 0))
         (prime phase.0. (if (eq Mut.0. 3) 3 phase.0.))))
  (def :Collect.0.#collect: only current matching Done receipt releases capacity.#
    (and (eq phase.0. 2) (prime phase.0. 3)))
  (def :Next.0.
    (and (eq err.0. 0) (or Begin.0. Complete.0. Peek.0. Retry.0. OldTicket.0. Collect.0.)))
  (def :Safe.0. (eq err.0. 0))
  (def :Reached.0.
    (and retried.0. (eq generation.0. 2) (eq phase.0. 3) (eq outcome.0. 1)))
  (spec (always-stutter Init.0. Next.0.
    (tuple phase.0. outcome.0. generation.0. retried.0. err.0.)))
  (check (if Witness.0. (not Reached.0.) Safe.0.)))
