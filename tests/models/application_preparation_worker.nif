(stmts#Copyright (c) 2026 Ragnarök contributors
SPDX-License-Identifier: MIT OR Apache-2.0
One actual capacity-one preparation worker, one serialized host, one admission lifecycle.
phase: 0 Idle, 1 Queued, 2 Running, 3 Done. pc: 0 wait/dispatch, 1 executing,
2 activation retired before publication, 3 thread exited. stop joins before lease release.
Mut 1 releases on cancel; 2 permits early collect; 3 releases before joined close.
Witness reaches cancelled work with shutdown requested while execution remains active.
Source mapping and bounded assumptions: spec/model-checking.md.#
  (variables :phase.0. :pc.0. :stop.0. :leased.0. :cancelled.0. :used.0.)
  (assign Mut.0. 0)
  (assign Witness.0. (false))
  (def :Init.0.
    (and (prime phase.0. 0) (prime pc.0. 0) (prime stop.0. (false))
         (prime leased.0. (false)) (prime cancelled.0. (false))
         (prime used.0. (false))))
  (def :Submit.0.
    (and (not stop.0.) (not used.0.) (eq phase.0. 0)
         (prime phase.0. 1) (prime leased.0. (true)) (prime used.0. (true))))
  (def :Dispatch.0.
    (and (not stop.0.) (eq pc.0. 0) (eq phase.0. 1)
         (prime phase.0. 2) (prime pc.0. (if cancelled.0. 2 1))))
  (def :Execute.0.
    (and (eq pc.0. 1) (prime pc.0. 2)))
  (def :Publish.0.
    (and (eq pc.0. 2) (prime phase.0. 3) (prime pc.0. 0)))
  (def :Cancel.0.
    (and (not stop.0.) (neq phase.0. 0)
         (prime cancelled.0. (true))
         (prime leased.0. (if (eq Mut.0. 1) (false) leased.0.))))
  (def :Collect.0.
    (and (not stop.0.) (neq phase.0. 0)
         (or (eq phase.0. 3) (eq Mut.0. 2))
         (prime phase.0. 0) (prime leased.0. (false))))
  (def :RequestClose.0.
    (and (not stop.0.) (prime stop.0. (true))
         (prime leased.0. (if (eq Mut.0. 3) (false) leased.0.))))
  (def :Exit.0.
    (and stop.0. (eq pc.0. 0) (prime pc.0. 3)))
  (def :JoinedClose.0.
    (and stop.0. (eq pc.0. 3) (prime phase.0. 0) (prime leased.0. (false))))
  (def :Next.0.
    (or Submit.0. Dispatch.0. Execute.0. Publish.0. Cancel.0. Collect.0.
        RequestClose.0. Exit.0. JoinedClose.0.))
  (def :Safe.0.
    (and (or (and (neq pc.0. 1) (neq pc.0. 2)) leased.0.)
         (or (eq phase.0. 0) leased.0. (and stop.0. (eq pc.0. 3)))))
  (def :Reached.0.
    (and stop.0. cancelled.0. (eq pc.0. 1) leased.0.))
  (spec (always-stutter Init.0. Next.0.
    (tuple phase.0. pc.0. stop.0. leased.0. cancelled.0. used.0.)))
  (check (if Witness.0. (not Reached.0.) Safe.0.)))
