(stmts#Copyright (c) 2026 Ragnarök contributors
 SPDX-License-Identifier: MIT OR Apache-2.0

 Hypothesis: publication races reader admission and reclamation can remove the reader's captured epoch.
 Source: src/storage/paged/store.nim openPagedReader (CURRENT/pin/CURRENT admission), publish, reclaim;
 src/storage/paged/io.nim openEpoch (flock SH/EX nonblocking), removePinned (unlink under EX).
 Full mapping: src/storage/full/paged/store.nim openFullPagedReader (same CURRENT/SH/CURRENT gate),
 publish (same guarded rename), reclaim (same captured EX/current-check/unlink gate).
 Full graph verification occurs while SH/EX remains held and does not add a release window.
 Atomicity: CURRENT read, independent flock acquisition, atomic rename, unlink, and close are separate steps.
 Variables: cur 0 old / 1 new; present old inode name; reader 0 start/1 captured/2 pinned/3 admitted/4 retired;
 pin reader shared lock; ex cleanup exclusive lock; writer 0 before publish/1 published/2 locked/3 unlinked;
 stale records whether admission observed a changed CURRENT. Scope: one old reader and one publication,
 supported cooperative flock filesystem; file authentication, durability and hostile namespace substitution are native tests.
 Mut 1 removes exclusive-pin exclusion; Mut 2 removes the post-pin CURRENT equality guard.
 Witness reaches a retained admitted old reader after publication. Only the final check is active.#
  (variables :cur.0. :present.0. :reader.0. :pin.0. :ex.0. :writer.0. :stale.0.)
  (assign Mut.0. 0)
  (assign Witness.0. (false))
  (def :Init.0.
    (and (prime cur.0. 0) (prime present.0. (true)) (prime reader.0. 0)
      (prime pin.0. (false)) (prime ex.0. (false)) (prime writer.0. 0) (prime stale.0. (false))))
  (def :Capture.0.#First bounded CURRENT read; only the old epoch is in this model's reclamation scope.#
    (and (eq reader.0. 0) (prime reader.0. (if (eq cur.0. 0) 1 4))))
  (def :ReaderPin.0.#openEpoch SH|NB cannot coexist with cleanup's independent exclusive open.#
    (and (eq reader.0. 1)
      (if (and present.0. (not ex.0.))
        (and (prime reader.0. 2) (prime pin.0. (true)))
        (prime reader.0. 4))))
  (def :Admit.0.#Second CURRENT read refuses a changed manifest and retires the acquired shared pin.#
    (and (eq reader.0. 2)
      (if (or (eq cur.0. 0) (eq Mut.0. 2))
        (and (prime reader.0. 3) (prime stale.0. (not (eq cur.0. 0))))
        (and (prime reader.0. 4) (prime pin.0. (false))))))
  (def :ReaderClose.0.#Explicit close retires only this independent reader pin.#
    (and (eq reader.0. 3) (prime reader.0. 4) (prime pin.0. (false))))
  (def :Publish.0.#Atomic CURRENT rename selects a new epoch without retiring readers.#
    (and (eq writer.0. 0) (prime cur.0. 1) (prime writer.0. 1)))
  (def :CleanupPin.0.#reclaim opens an independent EX|NB handle and never upgrades a reader lock.#
    (and (eq writer.0. 1) (or (not pin.0.) (eq Mut.0. 1))
      (prime ex.0. (true)) (prime writer.0. 2)))
  (def :Unlink.0.#Only an exclusively pinned retired captured epoch reaches unlink.#
    (and (eq writer.0. 2) (prime present.0. (false)) (prime writer.0. 3)))
  (def :Next.0. (or Capture.0. ReaderPin.0. Admit.0. ReaderClose.0. Publish.0. CleanupPin.0. Unlink.0.))
  (def :Safe.0.
    (and (not stale.0.) (not (and pin.0. ex.0.))
      (implies (eq reader.0. 3) (and pin.0. present.0.))))
  (def :Reached.0. (and (eq reader.0. 3) (eq cur.0. 1) pin.0. present.0.))
  (spec (always-stutter Init.0. Next.0. (tuple cur.0. present.0. reader.0. pin.0. ex.0. writer.0. stale.0.)))
  (check (if Witness.0. (not Reached.0.) Safe.0.)))
