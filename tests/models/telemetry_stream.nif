(stmts#Copyright (c) 2026 Ragnarök contributors
SPDX-License-Identifier: MIT OR Apache-2.0
Hypothesis: releasing byte credit or mailbox storage while Writer still borrows a batch permits
replacement bytes or freed memory to reach an outstanding send.
Source: src/telemetry/stream.nim send/runConnected/release and src/telemetry/client.nim tick/event.
Ready0/Writing1/Done2 is the release/acquire ownership boundary. Borrow/Return bracket the
real streamio Writer.write+flush suspension: lib/std/streamio.nim coreSend retains the caller
buffer until it returns. Payload/partial-send correctness and cancellation are native socket tests.
The real2048-byte credit remains held until the complete batch returns; no prefix is reusable.
Mut1 publishes Ready before flush returns; Mut2 frees mailbox storage before joined Done.
This is an ownership safety model, not a proof of I/O or scheduler liveness.#
  (variables :phase.0. :busy.0. :credit.0. :stop.0. :freed.0. :borrowed.0.)
  (assign Mut.0. 0)
  (assign Witness.0. (false))
  (def :Init.0.
    (and (prime phase.0. 0) (prime busy.0. (false)) (prime credit.0. 0)
      (prime stop.0. (false)) (prime freed.0. (false)) (prime borrowed.0. (false))))
  (def :Submit.0.#Dispatcher send publishes only after copying a batch into exclusively owned storage.#
    (and (not freed.0.) (not stop.0.) (eq phase.0. 0) (eq credit.0. 0)
      (prime phase.0. 1) (prime credit.0. 2048)))
  (def :Borrow.0.#Worker starts Writer.write/flush; the same bytes can remain borrowed across suspension.#
    (and (not freed.0.) (eq phase.0. 1) (not busy.0.)
      (prime busy.0. (true)) (prime borrowed.0. (true))))
  (def :Return.0.#Worker publishes Ready only after the Writer releases its complete batch borrow.#
    (and (not freed.0.) busy.0. (prime busy.0. (false)) (prime phase.0. 0)))
  (def :EarlyReady.0.#Mutant moves Ready publication ahead of Writer completion.#
    (and (eq Mut.0. 1) (not freed.0.) busy.0. (eq phase.0. 1) (prime phase.0. 0)))
  (def :CollectCredit.0.#Client.tick observes Ready before releasing in-flight credit or sampling status.#
    (and (not freed.0.) (eq phase.0. 0) (eq credit.0. 2048) (prime credit.0. 0)))
  (def :Stop.0.#stop and close revoke submission before waking an idle task.#
    (and (not freed.0.) (not stop.0.) (prime stop.0. (true))))
  (def :Retire.0.#Task publishes Done only after outstanding I/O has returned and Writer.abort retires it.#
    (and (not freed.0.) stop.0. (not busy.0.) (eq phase.0. 0) (prime phase.0. 2)))
  (def :Free.0.#release joins Done before deallocating the task's stable mailbox.#
    (and (not freed.0.) stop.0. (or (eq phase.0. 2) (eq Mut.0. 2))
      (prime freed.0. (true))))
  (def :Next.0.
    (or Submit.0. Borrow.0. Return.0. EarlyReady.0. CollectCredit.0. Stop.0. Retire.0. Free.0.))
  (def :Safe.0.
    (or (not busy.0.) (and (not freed.0.) (eq credit.0. 2048))))
  (def :Reached.0. (and freed.0. borrowed.0. (eq phase.0. 2)))
  (spec (always-stutter Init.0. Next.0.
    (tuple phase.0. busy.0. credit.0. stop.0. freed.0. borrowed.0.)))
  (check (if Witness.0. (not Reached.0.) Safe.0.)))
