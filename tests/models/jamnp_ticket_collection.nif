(stmts#Copyright (c) 2026 Ragnarök contributors
SPDX-License-Identifier: MIT OR Apache-2.0
Hypothesis: a genuine proof completes after its epoch/window expires or its stream closes;
a caller must not acknowledge it or newly retain it as current pending data.
Source: src/app/node.nim finishTicket/poll; src/jamnp-s/ticket_pool.nim retain;
src/app/proof/worker.nim run/collect. Capacity-one worker phases0Idle/1Queued/2Running/3Done/4Collected.
clock0 is an admissible observed distribution epoch/window; clock1 is expired.
One opaque genuine ticket abstracts bytes/crypto, not the actual2046-entry retention capacity.
The standalone public pool caller can legally retain with a fresh clock without calling expire first.
Fix=false is an intentionally unprotected design control, not a claim about previously shipped code.
Mut1 removes host freshness (load-bearing for finalized-included acknowledgment), Mut2 removes
public retain freshness, Mut3 removes host stream-liveness/cancellation observation.
Blind spots: cryptography, roster parsing, capacity, existing lock implementation and lease-token reuse.#
  (variables :phase.0. :clock.0. :live.0. :cancelled.0. :included.0. :ack.0. :kept.0. :err.0.)
  (assign Fix.0. (true))
  (assign Mut.0. 0)
  (assign Witness.0. (false))
  (def :Init.0.
    (and (prime phase.0. 0) (prime clock.0. 0) (prime live.0. (true))
         (prime cancelled.0. (false)) (prime ack.0. (false)) (prime kept.0. (false))
         (prime err.0. 0)
         (or (prime included.0. (true)) (prime included.0. (false)))))
  (def :Fresh.0. (eq clock.0. 0))
  (def :HostFresh.0. (or (not Fix.0.) (eq Mut.0. 1) Fresh.0.))
  (def :PoolFresh.0. (or (not Fix.0.) (eq Mut.0. 2) Fresh.0.))
  (def :HostLive.0. (or (eq Mut.0. 3) live.0.))
  (def :HostAccept.0.
    (and (not cancelled.0.) HostLive.0. HostFresh.0. (or included.0. PoolFresh.0.)))
  (def :PublicKeep.0. (and (not cancelled.0.) (not included.0.) PoolFresh.0.))
  (def :Submit.0.#beginIncoming/beginNetworkTicket: a complete authenticated request captures one still-current source.#
    (and (eq err.0. 0) (eq phase.0. 0) Fresh.0. live.0. (prime phase.0. 1)))
  (def :Run.0.#worker.run: the queued immutable input begins outside the host lock.#
    (and (eq err.0. 0) (eq phase.0. 1) (prime phase.0. 2)))
  (def :Done.0.#worker.run publishes Done only after the complete checker activation retires.#
    (and (eq err.0. 0) (eq phase.0. 2) (prime phase.0. 3)))
  (def :ClockExpires.0.#A later legal caller observation can cross lottery cutoff or epoch while CPU work is queued/running/Done.#
    (and (eq err.0. 0) (ge phase.0. 1) (le phase.0. 3) Fresh.0. (prime clock.0. 1)))
  (def :PeerCloses.0.#Native reset/connection closure revokes the exact stream before a host collection turn.#
    (and (eq err.0. 0) (ge phase.0. 1) (le phase.0. 3) live.0. (prime live.0. (false))))
  (def :ObserveCancellation.0.#poll requests exact cancellation even if the worker has already reached Done.#
    (and (eq err.0. 0) (ge phase.0. 1) (le phase.0. 3) (not live.0.)
         (not cancelled.0.) (prime cancelled.0. (true))))
  (def :HostCollect.0.#poll/finishTicket: exact uncancelled completion still needs live-stream and fresh source/window checks.#
    (and (eq err.0. 0) (eq phase.0. 3) (prime phase.0. 4)
         (prime ack.0. HostAccept.0.) (prime kept.0. (and HostAccept.0. (not included.0.)))
         (prime err.0. (if HostAccept.0.
           (if (not live.0.) 3 (if (not Fresh.0.) (if included.0. 1 2) 0)) 0))))
  (def :PublicCollectAndRetain.0.#An independent legal pool caller supplies current time to retain; stream lifetime does not invalidate mathematical proof content.#
    (and (eq err.0. 0) (eq phase.0. 3) (prime phase.0. 4)
         (prime ack.0. (false)) (prime kept.0. PublicKeep.0.)
         (prime err.0. (if (and PublicKeep.0. (not Fresh.0.)) 2 0))))
  (def :Next.0.
    (or Submit.0. Run.0. Done.0. ClockExpires.0. PeerCloses.0. ObserveCancellation.0.
        HostCollect.0. PublicCollectAndRetain.0.))
  (def :Safe.0. (eq err.0. 0))
  (def :Reached.0.#Done with a now-expired source is reachable before either caller collects it.#
    (and (eq phase.0. 3) (eq clock.0. 1) live.0. (not cancelled.0.)))
  (spec (always-stutter Init.0. Next.0.
    (tuple phase.0. clock.0. live.0. cancelled.0. included.0. ack.0. kept.0. err.0.)))
  (check (if Witness.0. (not Reached.0.) Safe.0.)))
