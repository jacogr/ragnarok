(stmts#Copyright (c) 2026 Ragnarök contributors
SPDX-License-Identifier: MIT OR Apache-2.0
Actual two-worker/four-slot proof offload pool, one distinguished job with interchangeable remaining slots.
phase 0 Free, 1 Queued, 2 Running, 3 Done; w1/w2 0 idle, 1 distinguished job, 2 other, 3 exited.
q/d count other queued/done slots; their running count comes from the worker PCs.
Hypothesis: cancel/stop frees running capacity before native return, duplicate claims occur,
or uncollected completions stop counting toward the real four-slot admission bound.
Source: src/jamnp-s/offload.nim worker/submitPool/cancelPool/collectPool/stopPool, enabled offload profile.
Job bytes, setup failure, test-only held gate, crypto results and job IDs remain native/E2E checks.#
  (variables :phase.0. :q.0. :d.0. :w1.0. :w2.0. :cancelled.0.
              :stop.0. :joined.0. :saturated.0.)
  (assign Mut.0. 0)
  (assign Witness.0. (false))
  (def :Init.0.
    (and (prime phase.0. 0) (prime q.0. 0) (prime d.0. 0)
         (prime w1.0. 0) (prime w2.0. 0) (prime cancelled.0. (false))
         (prime stop.0. (false)) (prime joined.0. (false)) (prime saturated.0. (false))))
  (def :OtherRunning.0.
    (plus (if (eq w1.0. 2) 1 0) (if (eq w2.0. 2) 1 0)))
  (def :Occupied.0.
    (plus (plus q.0. d.0.) (plus OtherRunning.0. (if (eq phase.0. 0) 0 1))))
  (def :AdmissionCount.0.#submitPool counts queued, running AND uncollected completions.#
    (if (eq Mut.0. 4)
      (plus (plus q.0. OtherRunning.0.) (if (or (eq phase.0. 1) (eq phase.0. 2)) 1 0))
      Occupied.0.))
  (def :SubmitTarget.0.#submitPool: a free slot owns its copied bytes before signaling.#
    (and (not stop.0.) (eq phase.0. 0) (lt AdmissionCount.0. 4)
         (prime phase.0. 1) (prime cancelled.0. (false))
         (prime saturated.0. (or saturated.0. (eq Occupied.0. 3)))))
  (def :SubmitOther.0.#submitPool: other slots obey the same real capacity-four admission bound.#
    (and (not stop.0.) (lt AdmissionCount.0. 4) (prime q.0. (plus q.0. 1))
         (prime saturated.0. (or saturated.0. (eq Occupied.0. 3)))))
  (def :Claim1.0.#worker: each claim and phase change is atomic under the shared mutex.#
    (and (not stop.0.) (eq w1.0. 0)
         (or (and (or (eq phase.0. 1) (and (eq Mut.0. 1) (eq phase.0. 2)))
                  (prime w1.0. 1) (prime phase.0. 2))
             (and (gt q.0. 0) (prime q.0. (minus q.0. 1)) (prime w1.0. 2)))))
  (def :Claim2.0.#worker: the second worker cannot claim a slot already marked Running.#
    (and (not stop.0.) (eq w2.0. 0)
         (or (and (or (eq phase.0. 1) (and (eq Mut.0. 1) (eq phase.0. 2)))
                  (prime w2.0. 1) (prime phase.0. 2))
             (and (gt q.0. 0) (prime q.0. (minus q.0. 1)) (prime w2.0. 2)))))
  (def :Return1.0.#worker: only after synchronous Rust returns may cancellation release/reuse its slot.#
    (or (and (eq w1.0. 1) (prime w1.0. 0)
             (prime phase.0. (if (or cancelled.0. stop.0.) 0 3))
             (prime cancelled.0. (false)))
        (and (eq w1.0. 2) (prime w1.0. 0)
             (prime d.0. (if stop.0. d.0. (plus d.0. 1))))))
  (def :Return2.0.#worker: other completions also retain capacity until collection/discard.#
    (or (and (eq w2.0. 1) (prime w2.0. 0)
             (prime phase.0. (if (or cancelled.0. stop.0.) 0 3))
             (prime cancelled.0. (false)))
        (and (eq w2.0. 2) (prime w2.0. 0)
             (prime d.0. (if stop.0. d.0. (plus d.0. 1))))))
  (def :Cancel.0.#cancelPool: queued/done slots may free; Running is marked and retained.#
    (and (not stop.0.) (neq phase.0. 0)
         (prime phase.0. (if (and (eq phase.0. 2) (neq Mut.0. 2)) 2 0))
         (prime cancelled.0. (eq phase.0. 2))))
  (def :Collect.0.#collectPool: explicit Done collection, never Running, releases capacity.#
    (and (not stop.0.)
         (or (and (eq phase.0. 3) (prime phase.0. 0))
             (and (gt d.0. 0) (prime d.0. (minus d.0. 1))))))
  (def :Stop.0.#stopPool: drop queued/done, retain and cancel Running, wake both workers.#
    (and (not stop.0.) (prime stop.0. (true)) (prime q.0. 0) (prime d.0. 0)
         (prime phase.0. (if (and (eq phase.0. 2) (neq Mut.0. 3)) 2 0))
         (prime cancelled.0. (eq phase.0. 2))))
  (def :Exit1.0.#worker: idle stop observation retires this worker and its private Rust setup.#
    (and stop.0. (eq w1.0. 0) (prime w1.0. 3)))
  (def :Exit2.0.#worker: the second private setup also retires before pool synchronization.#
    (and stop.0. (eq w2.0. 0) (prime w2.0. 3)))
  (def :Join.0.#stopPool: both joins complete before condition/mutex destruction.#
    (and stop.0. (eq w1.0. 3) (eq w2.0. 3) (prime joined.0. (true))))
  (def :Next.0.
    (or SubmitTarget.0. SubmitOther.0. Claim1.0. Claim2.0. Return1.0. Return2.0.
        Cancel.0. Collect.0. Stop.0. Exit1.0. Exit2.0. Join.0.))
  (def :Safe.0.
    (and (le Occupied.0. 4)
         (not (and (eq w1.0. 1) (eq w2.0. 1)))
         (or (and (neq w1.0. 1) (neq w2.0. 1)) (eq phase.0. 2))
         (or (not joined.0.) (and (eq w1.0. 3) (eq w2.0. 3)))))
  (def :Reached.0.
    (and saturated.0. stop.0. cancelled.0. (eq phase.0. 2) (not joined.0.)
         (or (and (eq w1.0. 1) (eq w2.0. 2)) (and (eq w1.0. 2) (eq w2.0. 1)))))
  (spec (always-stutter Init.0. Next.0.
    (tuple phase.0. q.0. d.0. w1.0. w2.0. cancelled.0. stop.0. joined.0. saturated.0.)))
  (check (if Witness.0. (not Reached.0.) Safe.0.)))
