+static void
+test_path_response_nonce (void)
+{
+    struct ietf_full_conn conn;
+    struct lsquic_packet_in packet_in;
+    struct conn_path *path;
+    unsigned char response[9];
+    unsigned i, index;
+    int len;
+    const unsigned order[] = { 0, 1, 0 };
+
+    memset(&conn, 0, sizeof(conn));
+    memset(&packet_in, 0, sizeof(packet_in));
+    conn.ifc_conn.cn_pf = select_pf_by_ver(LSQVER_I001);
+    conn.ifc_used_paths = 1;
+    path = &conn.ifc_paths[0];
+    path->cop_path_chals[0] = 1;  /* Unpadded challenge sent first. */
+    path->cop_path_chals[1] = 2;  /* MTU-sized retry sent later. */
+    path->cop_n_chals = 2;
+    path->cop_padded_chals = 1u << 1;
+    lsquic_alarmset_set(&conn.ifc_alset, AL_PATH_CHAL, INITIAL_CHAL_TIMEOUT);
+
+    for (i = 0; i < sizeof(order) / sizeof(order[0]); ++i)
+    {
+        index = order[i];
+        len = conn.ifc_conn.cn_pf->pf_gen_path_resp_frame(response,
+                                    sizeof(response), path->cop_path_chals[index]);
+        assert(len == sizeof(response));
+        assert(len == process_path_response_frame(&conn, &packet_in,
+                                                        response, len));
+        assert(path->cop_flags & COP_VALIDATED);
+        assert(!!(path->cop_flags & COP_VALIDATED_MTU) == (i != 0));
+        assert(!!lsquic_alarmset_is_set(&conn.ifc_alset, AL_PATH_CHAL) == (i == 0));
+        assert(!(conn.ifc_send_flags & SF_SEND_PATH_CHAL));
+    }
 }
 
 
