root = true

[*]
indent_style = tab
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.json]
indent_style = space
indent_size = 2

[*.md]
max_line_length = 100

[*.nim]
indent_style = space
indent_size = 2

[*.py]
indent_style = space
indent_size = 4

[*.yaml]
indent_style = space
indent_size = 2

[*.rs]
indent_style = space
indent_size = 4
max_line_length = 100

[*.{c,h}]
indent_style = space
indent_size = 4
