{
  "source": "tests/native/nimony_composite_results.nim",
  "build_name": "composite-results",
  "crypto_library": null,
  "native_libraries": [],
  "name_template": "composite-{origin}-{member}",
  "description_template": "{origin} {member} runtime guard",
  "diagnostic": "value.status == None",
  "argument_fields": [
    "member",
    "origin"
  ],
  "cases": [
    {"identity": {"origin": "default", "member": "optional-value"}},
    {"identity": {"origin": "default", "member": "optional-consumed"}},
    {"identity": {"origin": "default", "member": "work-value"}},
    {"identity": {"origin": "default", "member": "work-consumed"}},
    {"identity": {"origin": "default", "member": "preimages-count"}},
    {"identity": {"origin": "default", "member": "preimages-consumed"}},
    {"identity": {"origin": "default", "member": "written"}},
    {"identity": {"origin": "default", "member": "digest-value"}},
    {"identity": {"origin": "default", "member": "digest-consumed"}},
    {"identity": {"origin": "error", "member": "optional-value"}},
    {"identity": {"origin": "error", "member": "optional-consumed"}},
    {"identity": {"origin": "error", "member": "work-value"}},
    {"identity": {"origin": "error", "member": "work-consumed"}},
    {"identity": {"origin": "error", "member": "preimages-count"}},
    {"identity": {"origin": "error", "member": "preimages-consumed"}},
    {"identity": {"origin": "error", "member": "written"}},
    {"identity": {"origin": "error", "member": "digest-value"}},
    {"identity": {"origin": "error", "member": "digest-consumed"}},
    {"diagnostic": "value.isPresent", "identity": {"origin": "default", "member": "absent-blob"}},
    {"diagnostic": "value.isPresent", "identity": {"origin": "absent", "member": "absent-blob"}},
    {"diagnostic": "value.outputKind == Success", "identity": {"origin": "1", "member": "error-work-blob"}},
    {"diagnostic": "value.outputKind == Success", "identity": {"origin": "2", "member": "error-work-blob"}},
    {"diagnostic": "value.outputKind == Success", "identity": {"origin": "3", "member": "error-work-blob"}},
    {"diagnostic": "value.outputKind == Success", "identity": {"origin": "4", "member": "error-work-blob"}},
    {"diagnostic": "value.outputKind == Success", "identity": {"origin": "5", "member": "error-work-blob"}},
    {"diagnostic": "value.outputKind == Success", "identity": {"origin": "6", "member": "error-work-blob"}},
    {"diagnostic": "not kind == Success", "identity": {"origin": "success", "member": "factory-work"}},
    {"diagnostic": "0 <= extent", "identity": {"origin": "negative", "member": "factory-written"}},
    {"diagnostic": "not reason == None", "identity": {"origin": "none", "member": "factory-failure"}}
  ]
