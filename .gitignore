.idea
.vscode

# Generated build output, dependency sources, test keys and logs.
/build/

# Default runtime state and private transport identity.
/data/

# Nim compiler caches may also be created beside source files.
nimcache/

# Python test-runner bytecode is generated, never source.
__pycache__/
*.pyc
*.pyo

# Retired dependency checkout may remain locally; it is no longer provisioned.
/vendor/xkcp/
